# Copy to .env.local (git-ignored) and fill in. Never commit .env.local.
# Without DATABASE_URL the app runs on embedded PGLite, which is fine for local work.
#
# Supabase project ZH3, session pooler. Martin types the password himself.
# sslmode=no-verify: the pooler certificate is signed by Supabase's own CA (same as
# "Ignore SSL Issues" on the n8n credential). The connection is still encrypted.
# DATABASE_URL=postgresql://postgres.xijjuxkqhahkotgmjlqv:<PASSWORD>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=no-verify

# n8n (only if you use its API instead of importing JSON through the UI)
# N8N_BASE_URL=https://hsg-consultancy-project.app.n8n.cloud
# N8N_API_KEY=

# The Jev key is never put in this project. It goes only in the n8n credential (see n8n/STATUS.md).

# Internal /sittings page. Unset means the page is switched off. Pick any long random string.
# SITTINGS_KEY=

# Optional AI step of the 'say it in your own words' box (W7). Leave unset: the box still works with keyword rules on the device.
# Both must be set, and W7 must be active in n8n, or the AI tick does not appear.
# WORDS_BOX=on
# WORDS_URL=https://hsg-consultancy-project.app.n8n.cloud/webhook/bev-words-jev
